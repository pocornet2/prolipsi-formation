# Réglages publics du back-office en ligne (aucun secret ici).
# Utilisés uniquement pour le build de production ; en local (npm run dev),
# le back-office reste en mode « local ».
# Les secrets (KEYSTATIC_GITHUB_CLIENT_ID, KEYSTATIC_GITHUB_CLIENT_SECRET,
# KEYSTATIC_SECRET) se saisissent dans Cloudflare, jamais dans ce fichier.
PUBLIC_KEYSTATIC_STORAGE=github
PUBLIC_KEYSTATIC_GITHUB_REPO=pocornet2/prolipsi-formation
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=prolipsi-formation-back-office
