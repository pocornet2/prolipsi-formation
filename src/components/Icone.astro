---
/**
 * Pictogrammes du site (bibliothèque Lucide, licence ISC).
 * Les noms correspondent aux choix proposés dans le back-office.
 */
import {
  GraduationCap,
  Users,
  ShoppingCart,
  FileText,
  FileCheck,
  ShieldCheck,
  BadgeCheck,
  Star,
  MapPin,
  Building,
  Building2,
  Calendar,
  Phone,
  Mail,
  Search,
  ArrowRight,
  Quote,
  ChevronLeft,
  ChevronRight,
  Plus,
  HeartPulse,
  Flame,
  HardHat,
  BriefcaseMedical,
  RefreshCw,
  UserPlus,
  FireExtinguisher,
  DoorOpen,
  PersonStanding,
  Siren,
  Zap,
  Clock,
  UsersRound,
  Coins,
  Cog,
  MessageCircle,
  ChevronDown,
  Presentation,
  Footprints,
  Lightbulb,
  CircleCheck,
  MessagesSquare,
  ClipboardList,
  SquareArrowRight,
} from '@lucide/astro';

const ICONES = {
  formation: GraduationCap,
  accompagnement: Users,
  materiel: ShoppingCart,
  devis: FileText,
  conformite: FileCheck,
  certification: ShieldCheck,
  qualite: BadgeCheck,
  avis: Star,
  localisation: MapPin,
  entreprise: Building,
  etablissement: Building2,
  calendrier: Calendar,
  telephone: Phone,
  email: Mail,
  recherche: Search,
  fleche: ArrowRight,
  citation: Quote,
  precedent: ChevronLeft,
  suivant: ChevronRight,
  plus: Plus,
  chevron: ChevronDown,
  secourisme: HeartPulse,
  incendie: Flame,
  prevention: HardHat,
  trousse: BriefcaseMedical,
  recyclage: RefreshCw,
  secours: UserPlus,
  extincteur: FireExtinguisher,
  evacuation: DoorOpen,
  deplacement: Footprints,
  postures: PersonStanding,
  alarme: Siren,
  electricite: Zap,
  duree: Clock,
  groupe: UsersRound,
  financement: Coins,
  engrenage: Cog,
  message: MessageCircle,
  pedagogie: Presentation,
  idee: Lightbulb,
  valide: CircleCheck,
  echange: MessagesSquare,
  liste: ClipboardList,
  signaletique: SquareArrowRight,
} as const;

export type NomIcone = keyof typeof ICONES;

interface Props {
  nom?: string | null;
  taille?: number;
  epaisseur?: number;
  class?: string;
}

const { nom, taille = 20, epaisseur = 2, class: classe } = Astro.props;
const Composant = nom ? ICONES[nom as NomIcone] : undefined;
---

{Composant && <Composant size={taille} stroke-width={epaisseur} class:list={['icone', classe]} aria-hidden="true" focusable="false" />}
