---
import type { Reglages, Navigation } from '../lib/content';
import { lien } from '../lib/content';
import Logo from './Logo.astro';
import Icone from './Icone.astro';

interface Props {
  reglages: Reglages;
  navigation: Navigation;
}
const { reglages, navigation } = Astro.props;
const { adresse } = reglages;
const telLien = reglages.telephone ? `tel:${reglages.telephone.replace(/[^\d+]/g, '')}` : '';
const annee = new Date().getFullYear();
const moitie = Math.ceil(navigation.piedDePage.length / 2);
const colonnes = [navigation.piedDePage.slice(0, moitie), navigation.piedDePage.slice(moitie)].filter((c) => c.length);

// Pictogrammes simples des réseaux (dessinés, sans logo officiel).
const RESEAUX: Record<string, string> = {
  LinkedIn: 'M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 10v7',
  Facebook: 'M14 8h-1.5A1.5 1.5 0 0 0 11 9.5V18M9 12h5',
  Instagram: 'M8 7h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM15 9h.01',
  YouTube: 'M10 9l5 3-5 3z',
  Google: 'M16 12h-4M16 12a4 4 0 1 1-1.2-2.8',
};
---

<footer class="pied">
  <div class="conteneur pied__grille">
    <div class="pied__marque">
      <Logo reglages={reglages} variante="pied" />
    </div>

    {
      colonnes.length > 0 && (
        <nav class="pied__nav" aria-label="Liens du pied de page">
          {colonnes.map((col) => (
            <ul role="list">
              {col.map((l) => (
                <li>
                  <a href={lien(l.url)}>{l.libelle}</a>
                </li>
              ))}
            </ul>
          ))}
        </nav>
      )
    }

    <address class="pied__contact">
      {
        (adresse.ville || adresse.rue) && (
          <p>
            <Icone nom="localisation" taille={18} />
            <span>
              {adresse.rue && (<>{adresse.rue}<br /></>)}
              {adresse.codePostal} {adresse.ville}
            </span>
          </p>
        )
      }
      {reglages.telephone && <p><Icone nom="telephone" taille={18} /><a href={telLien}>{reglages.telephone}</a></p>}
      {reglages.email && <p><Icone nom="email" taille={18} /><a href={`mailto:${reglages.email}`}>{reglages.email}</a></p>}
    </address>

    {
      reglages.reseaux.length > 0 && (
        <ul class="pied__reseaux" role="list">
          {reglages.reseaux.map((r) => (
            <li>
              <a href={r.url} rel="noopener" target="_blank" aria-label={`${r.nom} (nouvel onglet)`}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={RESEAUX[r.nom] ?? RESEAUX.Google} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="pied__bas">
    <div class="conteneur pied__bas-inner">
      <p>
        <span>© {annee} {reglages.nom} – Tous droits réservés</span>
        {navigation.liensLegaux.map((l) => (
          <a href={lien(l.url)}>{l.libelle}</a>
        ))}
      </p>
      {reglages.signature && <p class="pied__signature">{reglages.signature}</p>}
    </div>
  </div>
</footer>
