---
import type { Bloc } from '../../lib/content';
import { typo } from '../../lib/content';
import Icone from '../Icone.astro';
type Props = Extract<Bloc, { discriminant: 'temoignages' }>['value'];
const { titre, style = 'bulle', items = [] } = Astro.props;
// Un avis sans texte s'affiche comme un emplacement réservé (en attendant de vrais avis vérifiés).
---

<section class="section section--serree section--temoignages">
  <div class="conteneur">
    {titre && <h2 class="section__titre section__titre--souligne">{typo(titre)}</h2>}
    <ul class:list={['temoignages', `temoignages--${style}`]} role="list">
      {
        items.map((t) =>
          t.citation ? (
            <li>
              <figure class="temoignage">
                <Icone nom="citation" taille={28} class="temoignage__guillemet" />
                <blockquote>
                  <p>{typo(t.citation)}</p>
                </blockquote>
                <figcaption>
                  <strong>{t.auteur}</strong>
                  {t.contexte && <span>{t.contexte}</span>}
                </figcaption>
              </figure>
            </li>
          ) : (
            <li class="temoignage temoignage--vide">
              {style === 'guillemets' ? (
                <span class="temoignage__guillemets" aria-hidden="true">”</span>
              ) : (
                <Icone nom="message" taille={30} epaisseur={1.5} />
              )}
              <span>
                Emplacement pour un avis client vérifié
                {t.contexte && <small class="temoignage__contexte">{t.contexte}</small>}
              </span>
            </li>
          ),
        )
      }
    </ul>
  </div>
</section>
