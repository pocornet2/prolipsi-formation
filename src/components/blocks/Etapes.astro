---
import type { Bloc } from '../../lib/content';
import { typo } from '../../lib/content';
import Icone from '../Icone.astro';

type Props = Extract<Bloc, { discriminant: 'etapes' }>['value'];
const { titre, intro, style = 'centre', etapes = [] } = Astro.props;
---

<section class:list={['section', 'section--etapes', { 'section--bleue': style === 'ligne', 'section--serree': style === 'carte' }]}>
  <div class="conteneur">
    {titre && <h2 class="section__titre section__titre--souligne">{typo(titre)}</h2>}
    {intro && <p class="section__intro section__intro--court">{typo(intro)}</p>}
    <ol class:list={['etapes', `etapes--${style}`]} role="list">
      {
        etapes.map((e, i) => (
          <li class="etape">
            <Icone nom={e.icone} taille={style === 'carte' ? 44 : 36} epaisseur={1.5} class="etape__icone" />
            <span class="etape__numero">{String(i + 1).padStart(2, '0')}</span>
            <div class="etape__corps">
              <h3 class="etape__titre">{typo(e.titre)}</h3>
              {e.texte && <p class="etape__texte">{typo(e.texte)}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
