---
import { Picture } from 'astro:assets';
import type { Bloc } from '../../lib/content';
import { typo, lien } from '../../lib/content';
import { resolveImage } from '../../lib/images';
import Icone from '../Icone.astro';

type Props = Extract<Bloc, { discriminant: 'cartes' }>['value'];
const { surtitre, titre, intro, alignement = 'centre', style = 'cartes', note, cartes = [] } = Astro.props;
const simple = style === 'simple' || style === 'separees';
---

<section class:list={['section', simple ? 'section--cartes-simples' : 'section--douce']}>
  <div class="conteneur">
    {
      (surtitre || titre || intro) && (
        <header class:list={['section__tete', { 'section__tete--centre': alignement === 'centre' }]}>
          {surtitre && <p class="surtitre">{surtitre}</p>}
          {titre && <h2 class:list={['section__titre', { 'section__titre--souligne': simple }]}>{typo(titre)}</h2>}
          {intro && <p class="section__intro">{typo(intro)}</p>}
        </header>
      )
    }
    <ul class:list={['cartes', { 'cartes--simples': simple, 'cartes--separees': style === 'separees' }]} role="list">
      {
        cartes.map((c) => {
          const img = resolveImage(c.image);
          return (
            <li class:list={['carte', { 'carte--photo': img }]}>
              {img && (
                <Picture src={img} alt={c.alt ?? ''} formats={['avif', 'webp']} widths={[400, 640, 800]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" pictureAttributes={{ class: 'carte__image' }} />
              )}
              <div class="carte__corps">
                {c.icone && (
                  <span class="carte__pastille">
                    <Icone nom={c.icone} taille={simple ? 40 : 24} epaisseur={simple ? 1.5 : 2} />
                  </span>
                )}
                <h3 class="carte__titre">{typo(c.titre)}</h3>
                {c.texte && <p class="carte__texte">{typo(c.texte)}</p>}
                {c.lien && (
                  <a href={lien(c.lien)} class="carte__lien">
                    {c.lienLibelle || 'En savoir plus'}
                    <Icone nom="fleche" taille={18} />
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
    {note && <p class="cartes__note">{typo(note)}</p>}
  </div>
</section>
