---
import type { Bloc } from '../../lib/content';
import { typo } from '../../lib/content';
import { Picture } from 'astro:assets';
import { getServices } from '../../lib/content';
import { resolveImage } from '../../lib/images';

type Props = Extract<Bloc, { discriminant: 'listeServices' }>['value'];
const { surtitre, titre, intro } = Astro.props;
const services = await getServices();
---

<section class="section">
  <div class="conteneur">
    {
      (surtitre || titre || intro) && (
        <header class="section__tete">
          {surtitre && <p class="surtitre">{surtitre}</p>}
          {titre && <h2 class="section__titre">{typo(titre)}</h2>}
          {intro && <p class="section__intro">{intro}</p>}
        </header>
      )
    }
    <ul class="cartes cartes--media" role="list">
      {
        services.map(({ slug, entry }) => {
          const img = resolveImage(entry.image);
          return (
            <li class="carte carte--media">
              {img && (
                <Picture src={img} alt={entry.alt ?? ''} formats={['avif', 'webp']} widths={[400, 640, 800]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" pictureAttributes={{ class: 'carte__image' }} />
              )}
              <div class="carte__corps">
                <h3 class="carte__titre">
                  <a href={`/services/${slug}/`} class="carte__lien">
                    {entry.titre}
                  </a>
                </h3>
                {entry.resume && <p>{entry.resume}</p>}
                <span class="carte__plus" aria-hidden="true">En savoir plus →</span>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
