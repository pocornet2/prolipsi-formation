---
import type { Bloc } from '../../lib/content';
import { typo } from '../../lib/content';
import { getReglages, getFormations, CATEGORIES_FORMATION } from '../../lib/content';
import Icone from '../Icone.astro';

type Props = Extract<Bloc, { discriminant: 'contact' }>['value'] & {
  /** Formation présélectionnée dans « Votre besoin ». */
  besoin?: string;
};
const { titre, texte, variante = 'simple', zone, besoins, champProduits, besoin } = Astro.props;
const choixLibres = (besoins ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
const devis = variante === 'devis';
// Liste « Votre besoin » : le catalogue de formations, par catégorie.
const formations = devis && !choixLibres.length ? await getFormations() : [];
const parCategorie = Object.entries(CATEGORIES_FORMATION).map(([cle, nom]) => ({
  nom,
  items: formations.filter((f) => f.entry.categorie === cle),
}));
const r = await getReglages();
const site = Astro.site ?? new URL(Astro.url.origin);

// Trois modes d'envoi :
// - Netlify Forms : hébergement Netlify, aucune adresse saisie ;
// - service externe (Web3Forms, Formspree…) : adresse saisie dans les réglages ;
// - aucun : hébergement sans service de formulaire configuré → on affiche
//   un lien e-mail plutôt qu'un formulaire qui ne mènerait nulle part.
const action = r.formulaire?.action?.trim();
const cle = r.formulaire?.cle?.trim();
const netlify = !action && import.meta.env.DEPLOY_TARGET !== 'cloudflare';
const web3forms = !!action && action.includes('web3forms.com');
const formspree = !!action && action.includes('formspree.io');
const formulaireActif = netlify || (!!action && (!web3forms || !!cle));
if (!formulaireActif) {
  console.warn(
    '[contact] Aucun service d’envoi configuré pour le formulaire : un lien e-mail est affiché à la place. ' +
      'Renseignez « Formulaire de contact » dans Coordonnées et réglages.',
  );
}
const champPiege = web3forms ? 'botcheck' : formspree ? '_gotcha' : 'site-web';
const sujet = `Nouveau message depuis le site ${r.nom}`;
const telLien = r.telephone ? `tel:${r.telephone.replace(/[^\d+]/g, '')}` : '';
---

{devis ? (
<section class="devis" id="devis">
  <div class="devis__panneau">
    <div class="devis__panneau-inner">
      {titre && <h2 class="devis__titre section__titre--souligne">{typo(titre)}</h2>}
      {texte && <p class="devis__texte">{typo(texte)}</p>}
      <ul class="devis__coordonnees" role="list">
        {r.email && <li><Icone nom="email" taille={24} epaisseur={1.6} /><a href={`mailto:${r.email}`}>{r.email}</a></li>}
        {r.telephone && <li><Icone nom="telephone" taille={24} epaisseur={1.6} /><a href={telLien}>{r.telephone}</a></li>}
        {zone && <li><Icone nom="localisation" taille={24} epaisseur={1.6} /><span>{zone}</span></li>}
      </ul>
    </div>
  </div>
  <form
    class="devis__formulaire"
    name="devis"
    method="POST"
    action={formulaireActif ? action || '/merci/' : undefined}
    data-netlify={netlify ? 'true' : undefined}
    netlify-honeypot={netlify ? champPiege : undefined}
    data-mailto={formulaireActif ? undefined : r.email}
  >
    {netlify && <input type="hidden" name="form-name" value="devis" />}
    {web3forms && <input type="hidden" name="access_key" value={cle} />}
    {web3forms && <input type="hidden" name="subject" value={`Demande de devis formation · ${r.nom}`} />}
    {web3forms && <input type="hidden" name="from_name" value={r.nom} />}
    {web3forms && <input type="hidden" name="redirect" value={new URL('/merci/', site).href} />}
    {formspree && <input type="hidden" name="_subject" value={`Demande de devis formation · ${r.nom}`} />}
    <p class="visually-hidden" aria-hidden="true">
      <label>Ne pas remplir <input name={champPiege} tabindex="-1" autocomplete="off" /></label>
    </p>
    <div class="champ-ligne">
      <div class="champ">
        <label for="devis-nom">Nom <span class="requis" aria-hidden="true">*</span></label>
        <input id="devis-nom" name="nom" autocomplete="name" placeholder="Votre nom" required />
      </div>
      <div class="champ">
        <label for="devis-entreprise">Entreprise <span class="requis" aria-hidden="true">*</span></label>
        <input id="devis-entreprise" name="entreprise" autocomplete="organization" placeholder="Nom de votre entreprise" required />
      </div>
    </div>
    <div class="champ-ligne">
      <div class="champ">
        <label for="devis-email">Email <span class="requis" aria-hidden="true">*</span></label>
        <input id="devis-email" name="email" type="email" autocomplete="email" placeholder="votre@email.fr" required />
      </div>
      <div class="champ">
        <label for="devis-tel">Téléphone</label>
        <input id="devis-tel" name="telephone" type="tel" autocomplete="tel" placeholder="Votre téléphone" />
      </div>
    </div>
    <div class="champ-ligne">
      {!choixLibres.length && (
        <div class="champ">
          <label for="devis-nombre">Nombre de personnes</label>
          <input id="devis-nombre" name="participants" type="number" min="1" inputmode="numeric" placeholder="Nombre de participants" />
        </div>
      )}
      <div class="champ">
        <label for="devis-besoin">Votre besoin <span class="requis" aria-hidden="true">*</span></label>
        <select id="devis-besoin" name="besoin" required>
          <option value="">{choixLibres.length ? 'Sélectionnez votre besoin' : 'Sélectionnez une formation'}</option>
          {choixLibres.map((c) => <option>{c}</option>)}
          {parCategorie.filter((c) => c.items.length).map((c) => (
            <optgroup label={c.nom}>
              {c.items.map((f) => <option selected={f.entry.titre === besoin}>{f.entry.titre}</option>)}
            </optgroup>
          ))}
          {!choixLibres.length && <option>Autre besoin / je ne sais pas encore</option>}
        </select>
      </div>
    </div>
    {champProduits && (
      <div class="champ">
        <label for="devis-produits">{champProduits}</label>
        <input id="devis-produits" name="produits" placeholder="Ex. 4 extincteurs eau 6 L, 1 défibrillateur" />
      </div>
    )}
    <div class="champ">
      <label for="devis-message">Message</label>
      <textarea id="devis-message" name="message" rows="3" placeholder="Décrivez votre besoin…"></textarea>
    </div>
    <div class="devis__pied">
      <label class="case">
        <input type="checkbox" name="consentement" value="oui" required />
        <span>J’accepte l’utilisation de mes données pour répondre à ma demande.</span>
      </label>
      <button class="btn btn--principal" type="submit">Envoyer ma demande</button>
    </div>
  </form>
</section>
) : (
<section class="section" id="contact">
  <div class="conteneur duo duo--contact">
    <div class="duo__texte">
      {titre && <h2 class="section__titre">{typo(titre)}</h2>}
      {texte && <p class="section__intro">{texte}</p>}
      <ul class="coordonnees" role="list">
        {r.telephone && <li><span>Téléphone</span><a href={telLien}>{r.telephone}</a></li>}
        {r.email && <li><span>E-mail</span><a href={`mailto:${r.email}`}>{r.email}</a></li>}
        {r.adresse.ville && <li><span>Adresse</span>{[r.adresse.rue, `${r.adresse.codePostal} ${r.adresse.ville}`].filter(Boolean).join(', ')}</li>}
        {r.horaires && <li><span>Horaires</span>{r.horaires}</li>}
      </ul>
    </div>

    {
      !formulaireActif && (
        <div class="formulaire formulaire--simple">
          <p>Écrivez-nous directement, nous vous répondons rapidement.</p>
          {r.email && (
            <a class="btn btn--principal" href={`mailto:${r.email}?subject=${encodeURIComponent('Demande depuis le site')}`}>
              Nous écrire
            </a>
          )}
        </div>
      )
    }

    {formulaireActif && (
    <form
      class="formulaire"
      name="contact"
      method="POST"
      action={action || '/merci/'}
      data-netlify={netlify ? 'true' : undefined}
      netlify-honeypot={netlify ? champPiege : undefined}
    >
      {netlify && <input type="hidden" name="form-name" value="contact" />}
      {web3forms && <input type="hidden" name="access_key" value={cle} />}
      {web3forms && <input type="hidden" name="subject" value={sujet} />}
      {web3forms && <input type="hidden" name="from_name" value={r.nom} />}
      {web3forms && <input type="hidden" name="redirect" value={new URL('/merci/', site).href} />}
      {formspree && <input type="hidden" name="_subject" value={sujet} />}
      <p class="visually-hidden" aria-hidden="true">
        <label>Ne pas remplir <input name={champPiege} tabindex="-1" autocomplete="off" /></label>
      </p>
      <div class="champ">
        <label for="contact-nom">Nom</label>
        <input id="contact-nom" name="nom" autocomplete="name" required />
      </div>
      <div class="champ-ligne">
        <div class="champ">
          <label for="contact-email">E-mail</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="champ">
          <label for="contact-tel">Téléphone <span class="facultatif">(facultatif)</span></label>
          <input id="contact-tel" name="telephone" type="tel" autocomplete="tel" />
        </div>
      </div>
      <div class="champ">
        <label for="contact-message">Votre message</label>
        <textarea id="contact-message" name="message" rows="6" required></textarea>
      </div>
      <p class="formulaire__rgpd">
        Vos informations servent uniquement à répondre à votre demande. Elles ne sont ni revendues ni utilisées à d’autres fins.
      </p>
      <button class="btn btn--principal" type="submit">Envoyer le message</button>
    </form>
    )}
  </div>
</section>
)}

<script>
  // Sans service d'envoi configuré, la demande s'ouvre dans la messagerie
  // de l'internaute, déjà remplie, plutôt que de partir dans le vide.
  document.querySelectorAll<HTMLFormElement>('form[data-mailto]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const donnees = new FormData(form);
      const libelles: Record<string, string> = {
        nom: 'Nom',
        entreprise: 'Entreprise',
        email: 'Email',
        telephone: 'Téléphone',
        participants: 'Nombre de personnes',
        produits: 'Produits / quantités',
        besoin: 'Besoin',
        message: 'Message',
      };
      const corps = Object.entries(libelles)
        .map(([cle, libelle]) => `${libelle} : ${donnees.get(cle) || '-'}`)
        .join('\n');
      const sujet = `Demande de devis formation - ${donnees.get('entreprise') || ''}`;
      window.location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(sujet)}&body=${encodeURIComponent(corps)}`;
    });
  });
</script>
