# Hébergeur : cloudflare | netlify (facultatif : détecté automatiquement chez Cloudflare)
# DEPLOY_TARGET=cloudflare

# URL publique du site (sans slash final)
SITE_URL=https://www.exemple.fr

# Stockage du back-office : local (développement) | github (en ligne)
PUBLIC_KEYSTATIC_STORAGE=local

# Mode github : dépôt qui contient le site, sous la forme compte/depot
PUBLIC_KEYSTATIC_GITHUB_REPO=mon-compte/mon-site

# Mode github : générés automatiquement lors de la création de l'application GitHub
# (première visite de /keystatic en mode github, voir README)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
